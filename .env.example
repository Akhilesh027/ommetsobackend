# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_USER_URL=http://localhost:5173
CLIENT_ADMIN_URL=http://localhost:5174

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/omeetso

# JWT Secrets
JWT_ACCESS_SECRET=omeetso_dev_access_secret_key_32_characters_minimum
JWT_REFRESH_SECRET=omeetso_dev_refresh_secret_key_32_characters_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=mock_cloud_name
CLOUDINARY_API_KEY=mock_api_key
CLOUDINARY_API_SECRET=mock_api_secret

# SMS Gateway (Twilio / MSG91)
SMS_PROVIDER=mock
